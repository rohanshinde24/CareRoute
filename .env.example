DATABASE_URL=postgresql+psycopg://careroute:careroute@db:5432/careroute
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CAREROUTE_WEB_PORT=3001
MODEL_PROVIDER=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
MODEL_TIMEOUT_SECONDS=90
PROVIDER_SERVICE_URL=http://provider-service:8010
PROVIDER_TIMEOUT_SECONDS=3
PROVIDER_RETRY_ATTEMPTS=3
PROVIDER_RETRY_BACKOFF_SECONDS=0.1
PROVIDER_INTERNAL_TOKEN=replace-for-nonlocal-use
TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORT_TIMEOUT_SECONDS=2
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
OTEL_METRIC_EXPORT_INTERVAL_SECONDS=15
INNGEST_IS_PRODUCTION=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
